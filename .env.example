# Service Principal — used to authenticate to Azure Key Vault
SP_APP_CLIENT_ID=
SP_APP_CLIENT_SECRET=
SP_APP_TENANT_ID=

# Azure Key Vault URL
KEY_VAULT_URL=https://<your-keyvault-name>.vault.azure.net/

# Graph Delegated App — used for OneDrive OAuth (user delegated)
GRAPH_APP_CLIENT_ID=
GRAPH_APP_CLIENT_SECRET=
GRAPH_APP_REDIRECT_URI=http://localhost:8000/callback

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Optional overrides (defaults shown)
# GRAPH_APP_SCOPES=User.Read Files.ReadWrite Mail.ReadWrite Mail.Send offline_access api://<GRAPH_APP_CLIENT_ID>/Mail.ReadWrite.DomainScoped
# GRAPH_APP_TENANT=consumers
# GRAPH_APP_AUTHORITY_URL=https://login.microsoftonline.com
# JWT_EXPIRY_HOURS=1

# Domain-scoped mail access — comma-separated list of sender domains to allow.
# When set, all /mail/* endpoints only read/write messages from these domains.
# Requires the custom scope Mail.ReadWrite.DomainScoped defined on the app registration.
# MAIL_ALLOWED_DOMAINS=company.com,partner.org
